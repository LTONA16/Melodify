{
  "expo": {
    "name": "Melodify",
    "slug": "melodify",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "melodify",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "userInterfaceStyle": "automatic"
    },
    "ios": {
      "userInterfaceStyle": "automatic"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ]
  }
}
