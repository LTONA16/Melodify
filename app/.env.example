# Variables de entorno de Melodify.
#
# Solo hay variables públicas por diseño: el cliente de Spotify usa PKCE, así que
# no necesita ningún secreto (NFR3.1). Rellénalas en tu `.env` local; nunca aquí.
#
# Client ID de la app registrada en el panel de Spotify. Sin ella, la conexión
# queda en `notConfigured` y el resto de la app sigue funcionando (BR16.10).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
#
# Redirect exacto que devuelve Spotify tras autorizar. Si se deja vacío, la app
# calcula el suyo con `makeRedirectUri({ path: "spotify-callback" })`, que es el
# que hay que registrar en el panel para Expo Go (BR16.2).
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=
