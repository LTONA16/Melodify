# ==========================================
# Melodify / Ratetify - Environment Variables
# ==========================================
# Copia este archivo a .env y define los valores correspondientes para tu entorno local.

# --- Configuración de la Aplicación ---
APP_ENV=development
APP_NAME=Melodify
APP_VERSION=0.0.1
DEBUG=true

# --- API Backend ---
API_BASE_URL=https://api.melodify.example.com/v1
API_TIMEOUT=10000

# --- Servicios de Música (Spotify / Last.fm) ---
# Obtén tus credenciales en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=melodify://callback

# LASTFM_API_KEY=your_lastfm_api_key_here
# LASTFM_SHARED_SECRET=your_lastfm_secret_here

# --- Autenticación / Servicios Externos ---
# AUTH_DOMAIN=your_auth_domain
# FIREBASE_API_KEY=your_firebase_api_key_here
