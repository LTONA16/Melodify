# Variables del API de Melodify. Cópialas a `.env` y rellena los valores.
#
# Nada de lo que hay aquí llega al móvil: la app solo conoce
# EXPO_PUBLIC_API_URL. El client secret de Spotify no aparece porque el backend
# no habla con Spotify (PKCE sigue viviendo en la app).

# Entorno: development | test | production.
NODE_ENV=development

# Dónde escucha el proceso.
HOST=0.0.0.0
PORT=3000

# Postgres de docker compose. El puerto 55432 es el del contenedor: 5432 y 5433
# suelen estar ocupados por Postgres instalados en la máquina. Si cambias el
# mapeo en `docker-compose.yml`, cambia también estas dos URL.
DATABASE_URL="postgresql://melodify:melodify@localhost:55432/melodify?schema=public"

# La base de las pruebas: misma instancia, base distinta, para no borrar nada
# de desarrollo al correr la suite.
TEST_DATABASE_URL="postgresql://melodify:melodify@localhost:55432/melodify_test?schema=public"

# Secreto del JWT de acceso. 32 caracteres como mínimo; uno distinto por
# entorno y nunca el de estas líneas.
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# Vida del access token (formato de `ms`: 15m, 1h) y del refresh en días.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Orígenes permitidos por CORS, separados por comas. Vacío = ninguno (la app
# nativa no lo necesita; Swagger UI se sirve desde el mismo origen).
CORS_ORIGINS=

# Siembra el usuario demo/demo al arrancar las migraciones de desarrollo. En
# producción se deja en false.
SEED_DEMO=false
